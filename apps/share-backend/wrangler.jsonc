{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "opfs-share-backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-01",
	"compatibility_flags": ["nodejs_compat"],
	// Two KV namespaces:
	//   RENDEZVOUS — short-lived `{code -> {epk, expiresAt}}` map.
	//   BLOBS      — opaque share-blob bytes, picked up exactly once.
	// Run `wrangler kv namespace create RENDEZVOUS` (and BLOBS) once
	// and paste the returned ids here. The frontend reads
	// `NEXT_PUBLIC_SHARE_BACKEND_URL`; this Worker is loosely coupled
	// to the static site (ADR 0007).
	"kv_namespaces": [
		{
			"binding": "RENDEZVOUS",
			"id": "REPLACE_WITH_RENDEZVOUS_KV_ID"
		},
		{
			"binding": "BLOBS",
			"id": "REPLACE_WITH_BLOBS_KV_ID"
		}
	],
	"vars": {
		// Comma-separated list of origins allowed to call the backend.
		// Locked down at deploy time per environment.
		"ALLOWED_ORIGINS": "https://stephane-segning.github.io"
	},
	"observability": {
		"enabled": true
	}
}

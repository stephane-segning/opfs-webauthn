{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "opfs-share-backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-01",
	"compatibility_flags": ["nodejs_compat"],
	// KV holds the short-lived `{code -> {epk, expiresAt}}` map plus
	// the per-IP mint counter. R2 holds the opaque share blob — R2's
	// conditional put (`etagDoesNotMatch: "*"`) gives us atomic
	// single-upload semantics that KV cannot. Create both before
	// deploying:
	//   wrangler kv namespace create RENDEZVOUS
	//   wrangler r2 bucket create opfs-share-blobs
	// Hard rate limiting (DoS, brute force) is configured at the
	// Cloudflare zone level via WAF Rate Limiting Rules — the
	// in-code KV counter is best-effort defense-in-depth.
	"kv_namespaces": [
		{
			"binding": "RENDEZVOUS",
			"id": "REPLACE_WITH_RENDEZVOUS_KV_ID"
		}
	],
	"r2_buckets": [
		{
			"binding": "BLOBS",
			"bucket_name": "opfs-share-blobs"
		}
	],
	"vars": {
		// Comma-separated list of origins allowed to call the backend.
		// Locked down at deploy time per environment.
		"ALLOWED_ORIGINS": "https://stephane-segning.github.io"
	},
	"observability": {
		"enabled": true
	}
}

{
	"name": "@opfs/core-wasm",
	"version": "0.1.0",
	"private": true,
	"description": "Generated wasm-bindgen wrapper for opfs-core. Crypto + repo + share-protocol exposed to JS.",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"files": [
		"src",
		"dist"
	],
	"scripts": {
		"build": "wasm-pack build ../../crates/core --target web --out-dir ../../packages/core-wasm/dist --out-name opfs_core --release",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"typescript": "^5.8.2"
	}
}
